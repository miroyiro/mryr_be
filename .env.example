# 로컬 실행: 이 파일을 .env 로 복사해서 값 채우기 (.env 는 커밋 금지)
# IntelliJ: Run Configuration > Environment variables 에 붙여넣기
SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/miroyiro
DB_USERNAME=postgres
DB_PASSWORD=change-me

# scrap → backend (/internal/**) 에서 받는 키. scrap 의 BACKEND_INTERNAL_KEY 와 같은 값
INTERNAL_KEY=dev-backend-key
# backend → scrap 호출용 (scrap 의 INTERNAL_KEY 와 같은 값)
SCRAP_BASE_URL=http://localhost:8000
SCRAP_INTERNAL_KEY=dev-internal-key

JWT_SECRET=change-me-to-a-32-bytes-or-longer-random-string
CORS_ALLOWED_ORIGINS=http://localhost:5173
